rules_version = '2';

// ============================================================
// Liz — Regras de segurança do Firestore (equivalente ao RLS)
// Cada usuário autenticado só pode ler/escrever os PRÓPRIOS
// dados (users/{uid} e subcoleções). Todo o resto é negado.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // Só o dono do documento (uid do login) pode acessar
    function dono(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // ---------- Conta do usuário ----------
    // Criada no CADASTRO (nome, e-mail, data). Lida/atualizada no LOGIN.
    match /users/{uid} {
      allow read, update, delete: if dono(uid);
      allow create: if dono(uid);

      // Subcoleções do usuário (futuro: conversas, mural, anexos...)
      match /{documento=**} {
        allow read, write: if dono(uid);
      }
    }

    // ---------- Qualquer outra coleção: bloqueada ----------
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
